# Agora — RTC + Conversational AI Engine
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CHANNEL=propertyops-demo
# Leave blank if the Agora project is in "testing mode" (App ID only, no token, 24h)
AGORA_TOKEN=

# Murf Falcon (TTS vendor configured on the agent, not used by this backend)
MURF_API_KEY=

# LLM used by the Agora agent for tool calling
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Public base URL of THIS backend, so the Agora agent can reach the tools.
# Use a tunnel (cloudflared / ngrok) during development.
TOOLS_BASE_URL=http://localhost:8000

# Optional: pin the shift hour so time-of-day policy is reproducible (0-23).
# Leave blank to use the real clock.
PO_SIM_HOUR=23
